NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lendsqr_wallet
DB_SSL=false

# Use a random value of at least 32 characters outside local development.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=900

# The deterministic test provider keeps local development independent of Adjutor.
BLACKLIST_PROVIDER=test
BLACKLIST_TEST_IDENTITIES=blocked@example.com,+2348000000000
ADJUTOR_BASE_URL=https://adjutor.lendsqr.com
ADJUTOR_API_KEY=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-with-a-strong-password
ADMIN_PHONE=+2348099999999
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
